{
  "name": "agromarket-api",
  "version": "1.0.0",
  "description": "REST API интернет-магазина фермерских продуктов «АгроМаркет»",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:init": "node db/seed.js",
    "db:migrate": "node db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.1.0",
    "vitest": "^3.0.9",
    "@vitest/coverage-v8": "^5.1.1"
  }
}
