# Скопируйте в .env и заполните. Сам .env в Git не коммитится.
NODE_ENV=development
PORT=3001

# Локальный PostgreSQL. Для Neon добавьте ?sslmode=require в конец строки
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agromarket

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=2h

# Несколько адресов — через запятую, без слэша в конце
CORS_ORIGIN=http://localhost:5173

# Первый администратор (создаётся командами db:init и db:migrate)
ADMIN_EMAIL=admin@agromarket.kz
ADMIN_PASSWORD=change-me
